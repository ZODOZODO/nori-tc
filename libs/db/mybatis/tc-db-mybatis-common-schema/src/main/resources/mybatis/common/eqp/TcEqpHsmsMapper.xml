<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- tc_eqp_hsms Mapper XML (FIX) -->
<mapper namespace="com.nori.tc.db.mybatis.common.mapper.TcEqpHsmsMapper">

    <resultMap id="Map" type="com.nori.tc.db.domain.eqp.TcEqpHsms">
        <constructor>
            <idArg column="eqp_key" javaType="long"/>
            <arg column="device_id" javaType="int"/>
            <arg column="t3_timeout" javaType="int"/>
            <arg column="t5_timeout" javaType="int"/>
            <arg column="t6_timeout" javaType="int"/>
            <arg column="t7_timeout" javaType="int"/>
            <arg column="t8_timeout" javaType="int"/>
            <arg column="link_test_enabled" javaType="boolean"/>
            <arg column="link_test_interval" javaType="int"/>
            <arg column="max_msg_bytes" javaType="long"/>
            <arg column="created_at"
                 javaType="java.time.OffsetDateTime"
                 typeHandler="com.nori.tc.db.mybatis.common.typehandler.OffsetDateTimeTypeHandler"/>
            <arg column="updated_at"
                 javaType="java.time.OffsetDateTime"
                 typeHandler="com.nori.tc.db.mybatis.common.typehandler.OffsetDateTimeTypeHandler"/>
        </constructor>
    </resultMap>

    <sql id="Columns">
        eqp_key, device_id, t3_timeout, t5_timeout, t6_timeout, t7_timeout, t8_timeout,
        link_test_enabled, link_test_interval, max_msg_bytes, created_at, updated_at
    </sql>

    <insert id="insert">
        INSERT INTO tc_eqp_hsms
            (eqp_key, device_id, t3_timeout, t5_timeout, t6_timeout, t7_timeout, t8_timeout,
             link_test_enabled, link_test_interval, max_msg_bytes)
        VALUES
            (#{h.eqpKey},
             #{h.deviceId},
             #{h.t3Timeout},
             #{h.t5Timeout},
             #{h.t6Timeout},
             #{h.t7Timeout},
             #{h.t8Timeout},
             #{h.linkTestEnabled},
             #{h.linkTestInterval},
             #{h.maxMsgBytes})
    </insert>

    <update id="update">
        UPDATE tc_eqp_hsms
           SET device_id            = #{h.deviceId},
               t3_timeout           = #{h.t3Timeout},
               t5_timeout           = #{h.t5Timeout},
               t6_timeout           = #{h.t6Timeout},
               t7_timeout           = #{h.t7Timeout},
               t8_timeout           = #{h.t8Timeout},
               link_test_enabled    = #{h.linkTestEnabled},
               link_test_interval   = #{h.linkTestInterval},
               max_msg_bytes        = #{h.maxMsgBytes},
               updated_at           = CURRENT_TIMESTAMP
         WHERE eqp_key             = #{h.eqpKey}
    </update>

    <select id="findByEqpKey" resultMap="Map">
        SELECT <include refid="Columns"/>
          FROM tc_eqp_hsms
         WHERE eqp_key = #{eqpKey}
    </select>

    <delete id="deleteByEqpKey">
        DELETE FROM tc_eqp_hsms WHERE eqp_key = #{eqpKey}
    </delete>

</mapper>
