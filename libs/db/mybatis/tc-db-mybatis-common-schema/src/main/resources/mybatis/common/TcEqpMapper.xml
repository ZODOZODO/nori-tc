<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.nori.tc.db.mybatis.common.mapper.TcEqpMapper">

    <resultMap id="TcEqpMap" type="com.nori.tc.db.domain.eqp.TcEqp">
        <constructor>
            <idArg column="eqp_id" javaType="java.lang.String"/>
            <arg column="protocol_type"
                 javaType="com.nori.tc.db.domain.common.ProtocolType"
                 typeHandler="org.apache.ibatis.type.EnumTypeHandler"/>
            <arg column="eqp_ip" javaType="java.lang.String"/>
            <arg column="eqp_port" javaType="int"/>
            <arg column="model_key" javaType="long"/>
            <arg column="enabled" javaType="boolean"/>
            <arg column="created_at"
                 javaType="java.time.OffsetDateTime"
                 typeHandler="com.nori.tc.db.mybatis.common.typehandler.OffsetDateTimeTypeHandler"/>
            <arg column="updated_at"
                 javaType="java.time.OffsetDateTime"
                 typeHandler="com.nori.tc.db.mybatis.common.typehandler.OffsetDateTimeTypeHandler"/>
        </constructor>
    </resultMap>

    <sql id="TcEqpColumns">
        eqp_id, protocol_type, eqp_ip, eqp_port, model_key, enabled, created_at, updated_at
    </sql>

    <insert id="insert">
        INSERT INTO tc_eqp
            (eqp_id, protocol_type, eqp_ip, eqp_port, model_key, enabled)
        VALUES
            (#{e.eqpId},
             #{e.protocolType, typeHandler=org.apache.ibatis.type.EnumTypeHandler},
             #{e.eqpIp},
             #{e.eqpPort},
             #{e.modelKey},
             #{e.enabled})
    </insert>

    <update id="update">
        UPDATE tc_eqp
           SET protocol_type = #{e.protocolType, typeHandler=org.apache.ibatis.type.EnumTypeHandler},
               eqp_ip        = #{e.eqpIp},
               eqp_port      = #{e.eqpPort},
               model_key     = #{e.modelKey},
               enabled       = #{e.enabled},
               updated_at    = CURRENT_TIMESTAMP
         WHERE eqp_id        = #{e.eqpId}
    </update>

    <select id="findByEqpId" resultMap="TcEqpMap">
        SELECT <include refid="TcEqpColumns"/>
          FROM tc_eqp
         WHERE eqp_id = #{eqpId}
    </select>

    <select id="findAll" resultMap="TcEqpMap">
        SELECT <include refid="TcEqpColumns"/>
          FROM tc_eqp
        <where>
            <if test="protocolType != null">
                AND protocol_type = #{protocolType, typeHandler=org.apache.ibatis.type.EnumTypeHandler}
            </if>
            <if test="enabled != null">
                AND enabled = #{enabled}
            </if>
        </where>
        ORDER BY eqp_id ASC
        <if test="limit > 0">
            LIMIT #{limit} OFFSET #{offset}
        </if>
    </select>

    <delete id="deleteByEqpId">
        DELETE FROM tc_eqp WHERE eqp_id = #{eqpId}
    </delete>

</mapper>