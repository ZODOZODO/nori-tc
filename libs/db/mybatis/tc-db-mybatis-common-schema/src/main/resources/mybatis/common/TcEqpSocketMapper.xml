<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- tc_eqp_socket Mapper XML (FIX) -->
<mapper namespace="com.nori.tc.db.mybatis.common.mapper.TcEqpSocketMapper">

    <resultMap id="Map" type="com.nori.tc.db.domain.eqp.TcEqpSocket">
        <constructor>
            <idArg column="eqp_id" javaType="java.lang.String"/>
            <arg column="socket_protocol_type" javaType="java.lang.String"/>
            <arg column="charset" javaType="java.lang.String"/>
            <arg column="heartbeat_enabled" javaType="boolean"/>
            <arg column="heartbeat_interval_ms" javaType="int"/>
            <arg column="created_at"
                 javaType="java.time.OffsetDateTime"
                 typeHandler="com.nori.tc.db.mybatis.common.typehandler.OffsetDateTimeTypeHandler"/>
            <arg column="updated_at"
                 javaType="java.time.OffsetDateTime"
                 typeHandler="com.nori.tc.db.mybatis.common.typehandler.OffsetDateTimeTypeHandler"/>
        </constructor>
    </resultMap>

    <sql id="Columns">
        eqp_id, socket_protocol_type, charset, heartbeat_enabled, heartbeat_interval_ms, created_at, updated_at
    </sql>

    <insert id="insert">
        INSERT INTO tc_eqp_socket
            (eqp_id, socket_protocol_type, charset, heartbeat_enabled, heartbeat_interval_ms)
        VALUES
            (#{s.eqpId},
             #{s.socketProtocolType},
             /* charset NOT NULL + default('UTF-8') 안전 처리 */
             COALESCE(#{s.charset}, 'UTF-8'),
             #{s.heartbeatEnabled},
             #{s.heartbeatIntervalMs})
    </insert>

    <update id="update">
        UPDATE tc_eqp_socket
           SET socket_protocol_type  = #{s.socketProtocolType},
               charset               = COALESCE(#{s.charset}, charset),
               heartbeat_enabled     = #{s.heartbeatEnabled},
               heartbeat_interval_ms = #{s.heartbeatIntervalMs},
               updated_at            = CURRENT_TIMESTAMP
         WHERE eqp_id               = #{s.eqpId}
    </update>

    <select id="findByEqpId" resultMap="Map">
        SELECT <include refid="Columns"/>
          FROM tc_eqp_socket
         WHERE eqp_id = #{eqpId}
    </select>

    <delete id="deleteByEqpId">
        DELETE FROM tc_eqp_socket WHERE eqp_id = #{eqpId}
    </delete>

</mapper>
