<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.nori.tc.db.mybatis.common.mapper.TcModelMapper">

    <resultMap id="TcModelMap" type="com.nori.tc.db.domain.model.TcModel">
        <constructor>
            <idArg column="model_key" javaType="long"/>
            <arg column="model_name" javaType="java.lang.String"/>
            <arg column="model_version" javaType="java.lang.String"/>
            <arg column="comm_interface"
                 javaType="com.nori.tc.db.domain.common.ProtocolType"
                 typeHandler="org.apache.ibatis.type.EnumTypeHandler"/>
            <arg column="status"
                 javaType="com.nori.tc.db.domain.common.ModelStatus"
                 typeHandler="org.apache.ibatis.type.EnumTypeHandler"/>
            <arg column="maker" javaType="java.lang.String"/>
            <arg column="created_at"
                 javaType="java.time.OffsetDateTime"
                 typeHandler="com.nori.tc.db.mybatis.common.typehandler.OffsetDateTimeTypeHandler"/>
            <arg column="updated_at"
                 javaType="java.time.OffsetDateTime"
                 typeHandler="com.nori.tc.db.mybatis.common.typehandler.OffsetDateTimeTypeHandler"/>
            <arg column="created_by" javaType="java.lang.String"/>
            <arg column="updated_by" javaType="java.lang.String"/>
        </constructor>
    </resultMap>

    <sql id="TcModelColumns">
        model_key, model_name, model_version, comm_interface, status, maker, created_at, updated_at, created_by, updated_by
    </sql>

    <insert id="insert">
        INSERT INTO tc_model
            (model_name, model_version, comm_interface, status, maker, created_by, updated_by)
        VALUES
            (#{m.modelName},
             #{m.modelVersion},
             #{m.commInterface, typeHandler=org.apache.ibatis.type.EnumTypeHandler},
             #{m.status, typeHandler=org.apache.ibatis.type.EnumTypeHandler},
             #{m.maker},
             #{m.createdBy},
             #{m.updatedBy})
    </insert>

    <update id="update">
        UPDATE tc_model
           SET model_name    = #{m.modelName},
               model_version = #{m.modelVersion},
               comm_interface = #{m.commInterface, typeHandler=org.apache.ibatis.type.EnumTypeHandler},
               status         = #{m.status, typeHandler=org.apache.ibatis.type.EnumTypeHandler},
               maker          = #{m.maker},
               updated_by     = #{m.updatedBy},
               updated_at    = CURRENT_TIMESTAMP
         WHERE model_key     = #{m.modelKey}
    </update>

    <select id="findByModelKey" resultMap="TcModelMap">
        SELECT <include refid="TcModelColumns"/>
          FROM tc_model
         WHERE model_key = #{modelKey}
    </select>

    <select id="findByNameVersion" resultMap="TcModelMap">
        SELECT <include refid="TcModelColumns"/>
          FROM tc_model
         WHERE model_name = #{modelName}
           AND model_version = #{modelVersion}
    </select>

    <select id="findAll" resultMap="TcModelMap">
        SELECT <include refid="TcModelColumns"/>
          FROM tc_model
        ORDER BY model_key DESC
        <if test="limit > 0">
            LIMIT #{limit} OFFSET #{offset}
        </if>
    </select>

    <delete id="deleteByModelKey">
        DELETE FROM tc_model WHERE model_key = #{modelKey}
    </delete>

</mapper>
