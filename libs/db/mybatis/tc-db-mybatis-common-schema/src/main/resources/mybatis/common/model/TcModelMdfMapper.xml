<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.nori.tc.db.mybatis.common.mapper.model.TcModelMdfMapper">

    <resultMap id="TcModelMdfMap" type="com.nori.tc.db.domain.model.TcModelMdf">
        <constructor>
            <idArg column="mdf_key" javaType="long"/>
            <arg column="model_version_key" javaType="long"/>
            <arg column="mdf_name" javaType="java.lang.String"/>
            <arg column="mdf_file" javaType="byte[]" typeHandler="org.apache.ibatis.type.ByteArrayTypeHandler"/>
            <arg column="updated_at"
                 javaType="java.time.OffsetDateTime"
                 typeHandler="com.nori.tc.db.mybatis.common.typehandler.OffsetDateTimeTypeHandler"/>
        </constructor>
    </resultMap>

    <sql id="TcModelMdfColumns">
        mdf_key, model_version_key, mdf_name, mdf_file, updated_at
    </sql>

    <insert id="insert">
        INSERT INTO tc_model_mdf
            (model_version_key, mdf_name, mdf_file)
        VALUES
            (#{m.modelVersionKey},
             #{m.mdfName},
             #{m.mdfFile, typeHandler=org.apache.ibatis.type.ByteArrayTypeHandler})
    </insert>

    <update id="update">
        UPDATE tc_model_mdf
           SET model_version_key  = #{m.modelVersionKey},
               mdf_name   = #{m.mdfName},
               mdf_file   = #{m.mdfFile, typeHandler=org.apache.ibatis.type.ByteArrayTypeHandler},
               updated_at = CURRENT_TIMESTAMP
         WHERE mdf_key    = #{m.mdfKey}
    </update>

    <select id="findByMdfKey" resultMap="TcModelMdfMap">
        SELECT <include refid="TcModelMdfColumns"/>
          FROM tc_model_mdf
         WHERE mdf_key = #{mdfKey}
    </select>

    <select id="findByModelVersionKeyAndName" resultMap="TcModelMdfMap">
        SELECT <include refid="TcModelMdfColumns"/>
          FROM tc_model_mdf
         WHERE model_version_key = #{modelVersionKey}
           AND mdf_name = #{mdfName}
    </select>

    <select id="findAllByModelVersionKey" resultMap="TcModelMdfMap">
        SELECT <include refid="TcModelMdfColumns"/>
          FROM tc_model_mdf
         WHERE model_version_key = #{modelVersionKey}
         ORDER BY mdf_key DESC
        <if test="limit > 0">
            LIMIT #{limit} OFFSET #{offset}
        </if>
    </select>

    <delete id="deleteByMdfKey">
        DELETE FROM tc_model_mdf WHERE mdf_key = #{mdfKey}
    </delete>

</mapper>
