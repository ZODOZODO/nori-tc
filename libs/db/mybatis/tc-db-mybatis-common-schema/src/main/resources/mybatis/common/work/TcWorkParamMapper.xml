<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.nori.tc.db.mybatis.common.mapper.work.TcWorkParamMapper">

    <resultMap id="TcWorkParamMap" type="com.nori.tc.db.domain.work.TcWorkParam">
        <constructor>
            <idArg column="work_param_key" javaType="long"/>
            <arg column="work_key" javaType="long"/>
            <arg column="param_name" javaType="java.lang.String"/>
            <arg column="param_value" javaType="java.lang.String"/>
            <arg column="updated_at"
                 javaType="java.time.OffsetDateTime"
                 typeHandler="com.nori.tc.db.mybatis.common.typehandler.OffsetDateTimeTypeHandler"/>
        </constructor>
    </resultMap>

    <sql id="TcWorkParamColumns">
        work_param_key, work_key, param_name, param_value, updated_at
    </sql>

    <insert id="insert">
        INSERT INTO tc_work_param
            (work_key, param_name, param_value)
        VALUES
            (#{w.workKey},
             #{w.paramName},
             #{w.paramValue})
    </insert>

    <update id="updateByUniqueKey">
        UPDATE tc_work_param
           SET param_value = #{w.paramValue},
               updated_at  = CURRENT_TIMESTAMP
         WHERE work_key = #{w.workKey}
           AND param_name = #{w.paramName}
    </update>

    <select id="findByWorkKeyAndName" resultMap="TcWorkParamMap">
        SELECT <include refid="TcWorkParamColumns"/>
          FROM tc_work_param
         WHERE work_key = #{workKey}
           AND param_name = #{paramName}
    </select>

    <select id="findAllByWorkKey" resultMap="TcWorkParamMap">
        SELECT <include refid="TcWorkParamColumns"/>
          FROM tc_work_param
         WHERE work_key = #{workKey}
         ORDER BY work_param_key ASC
        <if test="limit > 0">
            LIMIT #{limit} OFFSET #{offset}
        </if>
    </select>

    <delete id="deleteByWorkParamKey">
        DELETE FROM tc_work_param WHERE work_param_key = #{workParamKey}
    </delete>

</mapper>
