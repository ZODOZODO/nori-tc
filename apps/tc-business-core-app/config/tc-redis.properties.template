################################################################################
# tc-redis.properties.template (TC-BUSINESS-CORE-APP)
#
# 목적
# - Business Core Redis 연결 템플릿입니다.
# - 실제 비밀번호는 환경변수로 주입합니다.
#
# 사용 방법
# 1) 본 파일을 복사해서 apps/tc-business-core-app/config/tc-redis.properties 를 생성합니다.
# 2) TC_BUSINESS_REDIS_PASSWORD 또는 TC_BUSINESS_CORE_REDIS_PASSWORD를 설정합니다.
################################################################################

spring.data.redis.host=localhost
spring.data.redis.port=6380
spring.data.redis.password=${TC_BUSINESS_CORE_REDIS_PASSWORD:${TC_BUSINESS_REDIS_PASSWORD:}}

# DLQ TTL (초)
tc.business.core.redis.dlq-ttl-seconds=604800
